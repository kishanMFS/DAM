# Copy this file to .env and use new, strong values on every deployment.
GHCR_OWNER=kishanmfs
IMAGE_TAG=latest

POSTGRES_DB=dam
POSTGRES_USER=dam_admin
POSTGRES_PASSWORD=
DB_USER=dam_app
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=1d

MINIO_ROOT_USER=dam_storage
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=dam-assets
MINIO_PUBLIC_URL=

RABBITMQ_DEFAULT_USER=dam_worker
RABBITMQ_DEFAULT_PASS=
RABBITMQ_DEFAULT_VHOST=dam

# Add the browser-facing production origin, e.g. https://dam.example.com.
CORS_ORIGINS=
