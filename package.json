{
  "name": "DAM",
  "private": true,
  "workspaces": [
    "ReactFrontend",
    "NodeBackend",
    "worker",
    "packages/shared-types"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present -- --runInBand",
    "react": "npm run dev --workspace=./ReactFrontend",
    "node": "npm run start --workspace=./NodeBackend && npm run build --workspace=./NodeBackend",
    "worker": "npm run dev --workspace=./worker",
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production') require('child_process').execSync('husky', { stdio: 'inherit' })\"",
    "composeup": "docker compose up -d --build",
    "composedown": "docker compose down"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.8",
    "prettier": "3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "amqplib": "^2.0.1",
    "minio": "^8.0.7",
    "pg-promise": "^12.7.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
